{
    "name": "cceconi/directive",
    "description": "Directive — PHP 8.4 REST framework designed for AI-assisted development.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Christian CECONI",
            "email": "christian.ceconi@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.4.0",
        "clue/socket-raw": "^1.6",
        "dflydev/fig-cookies": "^3.1",
        "lcobucci/jwt": "^5.3",
        "monolog/monolog": "^3.7",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.1",
        "php-di/php-di": "^7.0",
        "ramsey/uuid": "^4.7",
        "slim/slim": "^4.14",
        "symfony/console": "^7.2",
        "symfony/dotenv": "^7.2",
        "symfony/yaml": "^8.0"
    },
    "require-dev": {
        "pestphp/pest": "^3.8",
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.65"
    },
    "autoload": {
        "psr-4": {
            "Directive\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/src/"
        }
    },
    "scripts": {
        "test": "pest",
        "phpstan": "phpstan analyse --memory-limit=256M",
        "cs-fix": "php-cs-fixer fix",
        "cs-check": "php-cs-fixer fix --dry-run --diff"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}